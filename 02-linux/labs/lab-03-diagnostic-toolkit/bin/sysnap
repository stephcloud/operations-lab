#!/usr/bin/env bash
# sysnap: a one-screen snapshot of the server's current state.
set -euo pipefail

section() {
  printf "\n== %s ==\n" "$1"
}

section "Host"
hostnamectl | sed 's/^/  /'

section "Uptime and load"
uptime | sed 's/^/  /'

section "Memory (MB)"
free -m | sed 's/^/  /'

section "Top 5 CPU consumers"
ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu | head -n 6 | sed 's/^/  /'

section "Disk usage"
df -h --output=target,fstype,size,used,avail,pcent | grep -vE 'tmpfs|squashfs|overlay' | sed 's/^/  /'

section "Listening ports"
ss -tulnp 2>/dev/null | sed 's/^/  /'
